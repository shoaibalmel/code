# DevPilot Standard .gitignore
# Automatically generated to prevent pushing secrets and heavy dependencies to GitHub

# Secrets & Environment variables
.env
.env.*
*.env
*.pem
*.key
*.cert
credentials.json
client_secrets.json

# Dependencies & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python environments and bytecode
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg

# IDE, OS & System files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Runtime & Build artifacts
*.log
logs/
*.pid
*.seed
*.coverage
.pytest_cache/
.mypy_cache/
